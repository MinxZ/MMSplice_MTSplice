# Modal API Configuration
# Copy this file to .env and fill in your actual URLs after deployment

# Get these URLs from: modal deploy deployment/modal_app.py
MMSPLICE_PREDICT_URL=https://yourusername--mmsplice-api-predict.modal.run
MMSPLICE_HEALTH_URL=https://yourusername--mmsplice-api-health.modal.run
MMSPLICE_GENOMES_URL=https://yourusername--mmsplice-api-list-genomes.modal.run

# Optional: Add authentication token for production use
# MMSPLICE_API_TOKEN=your-secret-token-here
